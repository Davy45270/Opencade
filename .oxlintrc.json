{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript"
  ],
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "ignorePatterns": [
    ".pwa-fixtures/**",
    "dist/**",
    "node_modules/**",
    ".pw-browsers/**",
    ".npm-cache/**",
    "test-results/**",
    "playwright-report/**"
  ],
  "rules": {
    "typescript/ban-ts-comment": [
      "error",
      {
        "minimumDescriptionLength": 10
      }
    ],
    "eslint/no-array-constructor": "error",
    "typescript/no-duplicate-enum-values": "error",
    "typescript/no-dynamic-delete": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/no-extraneous-class": "error",
    "typescript/no-invalid-void-type": "error",
    "typescript/no-misused-new": "error",
    "typescript/no-namespace": "error",
    "typescript/no-non-null-asserted-nullish-coalescing": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-this-alias": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unsafe-declaration-merging": "error",
    "typescript/no-unsafe-function-type": "error",
    "eslint/no-unused-expressions": [
      "error",
      {
        "allowShortCircuit": false,
        "allowTaggedTemplates": false,
        "allowTernary": false
      }
    ],
    "eslint/no-unused-vars": "error",
    "eslint/no-useless-constructor": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/prefer-as-const": "error",
    "typescript/prefer-literal-enum-member": "error",
    "typescript/prefer-namespace-keyword": "error",
    "typescript/triple-slash-reference": "error",
    "typescript/unified-signatures": "error",
    "eslint/for-direction": "error",
    "eslint/no-async-promise-executor": "error",
    "eslint/no-case-declarations": "error",
    "eslint/no-compare-neg-zero": "error",
    "eslint/no-cond-assign": [
      "error",
      "except-parens"
    ],
    "eslint/no-constant-binary-expression": [
      "error",
      {
        "checkRelationalComparisons": false
      }
    ],
    "eslint/no-constant-condition": [
      "error",
      {
        "checkLoops": "allExceptWhileTrue"
      }
    ],
    "eslint/no-control-regex": "error",
    "eslint/no-debugger": "error",
    "eslint/no-delete-var": "error",
    "eslint/no-dupe-else-if": "error",
    "eslint/no-duplicate-case": "error",
    "eslint/no-empty": [
      "error",
      {
        "allowEmptyCatch": false
      }
    ],
    "eslint/no-empty-character-class": "error",
    "eslint/no-empty-pattern": [
      "error",
      {
        "allowObjectPatternsAsParameters": false
      }
    ],
    "eslint/no-empty-static-block": "error",
    "eslint/no-ex-assign": "error",
    "eslint/no-extra-boolean-cast": [
      "error",
      {}
    ],
    "eslint/no-fallthrough": [
      "error",
      {
        "allowEmptyCase": false,
        "reportUnusedFallthroughComment": false
      }
    ],
    "eslint/no-global-assign": [
      "error",
      {
        "exceptions": []
      }
    ],
    "eslint/no-invalid-regexp": [
      "error",
      {}
    ],
    "eslint/no-irregular-whitespace": [
      "error",
      {
        "skipComments": false,
        "skipJSXText": false,
        "skipRegExps": false,
        "skipStrings": true,
        "skipTemplates": false
      }
    ],
    "eslint/no-loss-of-precision": "error",
    "eslint/no-misleading-character-class": [
      "error",
      {
        "allowEscape": false
      }
    ],
    "eslint/no-nonoctal-decimal-escape": "error",
    "eslint/no-prototype-builtins": "error",
    "eslint/no-regex-spaces": "error",
    "eslint/no-self-assign": [
      "error",
      {
        "props": true
      }
    ],
    "eslint/no-shadow-restricted-names": [
      "error",
      {
        "reportGlobalThis": true
      }
    ],
    "eslint/no-sparse-arrays": "error",
    "eslint/no-unassigned-vars": "error",
    "eslint/no-unexpected-multiline": "error",
    "eslint/no-unsafe-finally": "error",
    "eslint/no-unsafe-optional-chaining": [
      "error",
      {
        "disallowArithmeticOperators": false
      }
    ],
    "eslint/no-unused-labels": "error",
    "eslint/no-unused-private-class-members": "error",
    "eslint/no-useless-assignment": "error",
    "eslint/no-useless-backreference": "error",
    "eslint/no-useless-catch": "error",
    "eslint/no-useless-escape": [
      "error",
      {
        "allowRegexCharacters": []
      }
    ],
    "eslint/preserve-caught-error": [
      "error",
      {
        "requireCatchParameter": false
      }
    ],
    "eslint/require-yield": "error",
    "eslint/use-isnan": [
      "error",
      {
        "enforceForIndexOf": false,
        "enforceForSwitchCase": true
      }
    ],
    "eslint/valid-typeof": [
      "error",
      {
        "requireStringLiterals": false
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/*.ts"
      ],
      "rules": {
        "typescript/await-thenable": "error",
        "typescript/no-array-delete": "error",
        "typescript/no-base-to-string": "error",
        "typescript/no-confusing-void-expression": "error",
        "typescript/no-deprecated": "error",
        "typescript/no-duplicate-type-constituents": "error",
        "typescript/no-floating-promises": "error",
        "typescript/no-for-in-array": "error",
        "typescript/no-generated-empty-object-type": "error",
        "typescript/no-implied-eval": "error",
        "typescript/no-meaningless-void-operator": "error",
        "typescript/no-misused-promises": "error",
        "typescript/no-misused-spread": "error",
        "typescript/no-mixed-enums": "error",
        "typescript/no-redundant-type-constituents": "error",
        "typescript/no-unnecessary-boolean-literal-compare": "error",
        "typescript/no-unnecessary-condition": "error",
        "typescript/no-unnecessary-template-expression": "error",
        "typescript/no-unnecessary-type-arguments": "error",
        "typescript/no-unnecessary-type-assertion": "error",
        "typescript/no-unnecessary-type-conversion": "error",
        "typescript/no-unnecessary-type-parameters": "error",
        "typescript/no-unsafe-argument": "error",
        "typescript/no-unsafe-assignment": "error",
        "typescript/no-unsafe-call": "error",
        "typescript/no-unsafe-enum-assignment": "error",
        "typescript/no-unsafe-enum-comparison": "error",
        "typescript/no-unsafe-member-access": "error",
        "typescript/no-unsafe-return": "error",
        "typescript/no-unsafe-unary-minus": "error",
        "typescript/no-useless-default-assignment": "error",
        "typescript/only-throw-error": "error",
        "typescript/prefer-promise-reject-errors": "error",
        "typescript/prefer-reduce-type-parameter": "error",
        "typescript/prefer-return-this-type": "error",
        "typescript/related-getter-setter-pairs": "error",
        "typescript/require-await": "error",
        "typescript/restrict-plus-operands": [
          "error",
          {
            "allowAny": false,
            "allowBoolean": false,
            "allowNullish": false,
            "allowNumberAndString": false,
            "allowRegExp": false
          }
        ],
        "typescript/restrict-template-expressions": [
          "error",
          {
            "allowAny": false,
            "allowBoolean": false,
            "allowNever": false,
            "allowNullish": false,
            "allowNumber": false,
            "allowRegExp": false
          }
        ],
        "typescript/return-await": [
          "error",
          "error-handling-correctness-only"
        ],
        "typescript/unbound-method": "error",
        "typescript/use-unknown-in-catch-callback-variable": "error",
        "eslint/no-var": "error",
        "eslint/prefer-const": [
          "error",
          {
            "destructuring": "any",
            "ignoreReadBeforeAssign": false
          }
        ],
        "eslint/prefer-rest-params": "error",
        "eslint/prefer-spread": "error"
      }
    },
    {
      "files": [
        "**/*.js"
      ],
      "globals": {
        "Buffer": "readonly",
        "Event": "readonly",
        "EventTarget": "readonly",
        "Image": "readonly",
        "URL": "readonly",
        "URLSearchParams": "readonly",
        "clearTimeout": "readonly",
        "console": "readonly",
        "document": "readonly",
        "fetch": "readonly",
        "localStorage": "readonly",
        "performance": "readonly",
        "process": "readonly",
        "setTimeout": "readonly",
        "structuredClone": "readonly",
        "window": "readonly"
      },
      "rules": {
        "eslint/constructor-super": "error",
        "eslint/getter-return": [
          "error",
          {
            "allowImplicit": false
          }
        ],
        "eslint/no-class-assign": "error",
        "eslint/no-const-assign": "error",
        "eslint/no-dupe-class-members": "error",
        "eslint/no-dupe-keys": "error",
        "eslint/no-func-assign": "error",
        "eslint/no-import-assign": "error",
        "eslint/no-new-native-nonconstructor": "error",
        "eslint/no-obj-calls": "error",
        "eslint/no-redeclare": [
          "error",
          {
            "builtinGlobals": true
          }
        ],
        "eslint/no-setter-return": "error",
        "eslint/no-this-before-super": "error",
        "eslint/no-undef": [
          "error",
          {
            "typeof": false
          }
        ],
        "eslint/no-unreachable": "error",
        "eslint/no-unsafe-negation": [
          "error",
          {
            "enforceForOrderingRelations": false
          }
        ],
        "eslint/no-with": "error"
      }
    },
    {
      "files": [
        "src/engines/**",
        "src/characters/model.ts"
      ],
      "rules": {
        "eslint/no-restricted-globals": [
          "error",
          "window",
          "document",
          "navigator",
          "location",
          "localStorage",
          "sessionStorage",
          "HTMLElement",
          "HTMLCanvasElement",
          "fetch",
          "requestAnimationFrame",
          "alert",
          "globalThis"
        ],
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              "phaser",
              "phaser/*"
            ]
          }
        ],
        "eslint/no-restricted-properties": [
          "error",
          {
            "object": "Math",
            "property": "random"
          }
        ]
      }
    }
  ]
}
