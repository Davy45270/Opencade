{
  "name": "opencade",
  "version": "0.6.0",
  "private": true,
  "description": "Twelve original HTML5 arcade games (Phaser 4, TypeScript), playable by touch, mouse and keyboard.",
  "license": "MIT",
  "author": "David Sevin",
  "homepage": "https://davy45270.github.io/Opencade/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Davy45270/Opencade.git"
  },
  "bugs": {
    "url": "https://github.com/Davy45270/Opencade/issues"
  },
  "keywords": [
    "phaser",
    "typescript",
    "arcade",
    "html5-game",
    "vite",
    "playwright"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-sites.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --max-warnings=0",
    "test": "vitest run --pool=threads --maxWorkers=2",
    "test:pwa": "node --test scripts/test-pwa.js",
    "test:e2e": "node scripts/build-pwa-fixture.js && playwright test",
    "test:node": "node scripts/test-node.js",
    "audit:gourmandises": "node --import ./scripts/ts-loader.js scripts/audit-gourmandises.js",
    "audit:derapage": "node scripts/audit-derapage-mutations.js"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "rolldown": "1.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  }
}
